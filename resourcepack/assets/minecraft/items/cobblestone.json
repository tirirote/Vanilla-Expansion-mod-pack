{
  "model": {
    "type": "minecraft:select",
    "property": "custom_model_data",
    "cases": [
      {
        "when": "vexp:enchanter_book",
        "model": {
          "type": "minecraft:model",
          "model": "vexp:item/mob_items/enchanter_book"
        }
      },
      {
        "when": "vexp:vindicator_chef_apron",
        "model": {
          "type": "minecraft:model",
          "model": "vexp:block/mob_overlay/vindicator_chef_apron"
        }
      },
      {
        "when": "vexp:vindicator_chef_hat",
        "model": {
          "type": "minecraft:model",
          "model": "vexp:block/mob_hats/vindicator_chef_hat"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:block/cobblestone"
    }
  }
}
