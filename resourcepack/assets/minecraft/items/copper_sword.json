{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "cases": [
      {
        "when": "vexp:copper_dagger",
        "model": {
          "type": "minecraft:model",
          "model": "vexp:item/dungeons/copper_dagger"
        }
      },
      {
        "when": "vexp:copper_scythe",
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:display_context",
          "cases": [
            {
              "when": ["gui", "ground", "fixed"],
              "model": {
                "type": "minecraft:model",
                "model": "vexp:item/dungeons/copper_scythe"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "vexp:item/dungeons/copper_scythe_hand"
          }
        }
      },
      {
        "when": "vexp:copper_spear",
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:display_context",
          "cases": [
            {
              "when": ["gui", "ground", "fixed"],
              "model": {
                "type": "minecraft:model",
                "model": "item/copper_spear"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "item/copper_spear_in_hand"
          }
        }
      },
      {
        "when": "vexp:copper_rapier",
        "model": {
          "type": "minecraft:model",
          "model": "vexp:item/dungeons/copper_rapier"
        }
      },
      {
        "when": "vexp:copper_gauntlet",
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:display_context",
          "cases": [
            {
              "when": ["gui", "ground", "fixed"],
              "model": {
                "type": "minecraft:model",
                "model": "vexp:item/dungeons/copper_gauntlet"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "vexp:item/dungeons/copper_gauntlet_hand"
          }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/copper_sword"
    }
  }
}
