{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "cases": [
      {
        "when": "vexp:stone_dagger",
        "model": {
          "type": "minecraft:model",
          "model": "vexp:item/dungeons/stone_dagger"
        }
      },
      {
        "when": "vexp:stone_spear",
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:display_context",
          "cases": [
            {
              "when": ["gui", "ground", "fixed"],
              "model": {
                "type": "minecraft:model",
                "model": "item/stone_spear"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "item/stone_spear_in_hand"
          }
        }
      },
      {
        "when": "vexp:stone_scythe",
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:display_context",
          "cases": [
            {
              "when": ["gui", "ground", "fixed"],
              "model": {
                "type": "minecraft:model",
                "model": "vexp:item/dungeons/stone_scythe"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "vexp:item/dungeons/stone_scythe_hand"
          }
        }
      },
      {
        "when": "vexp:stone_rapier",
        "model": {
          "type": "minecraft:model",
          "model": "vexp:item/dungeons/stone_rapier"
        }
      },
      {
        "when": "vexp:stone_gauntlet",
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:display_context",
          "cases": [
            {
              "when": ["gui", "ground", "fixed"],
              "model": {
                "type": "minecraft:model",
                "model": "vexp:item/dungeons/stone_gauntlet"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "vexp:item/dungeons/stone_gauntlet_hand"
          }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/stone_sword"
    }
  }
}
