{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "cases": [
      {
        "when": "vexp:stone_dagger",
        "model": {
          "type": "minecraft:model",
          "model": "vexp:item/dungeons/stone_dagger"
        }
      },
      {
        "when": "vexp:stone-scythe",
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:display_context",
          "cases": [
            {
              "when": ["gui", "ground", "fixed"],
              "model": {
                "type": "minecraft:model",
                "model": "vexp:item/dungeons/stone-scythe"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "vexp:item/dungeons/stone-scythe-hand"
          }
        }
      },
      {
        "when": "vexp:stone-rapier",
        "model": {
          "type": "minecraft:model",
          "model": "vexp:item/dungeons/stone-rapier"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/stone_sword"
    }
  }
}
