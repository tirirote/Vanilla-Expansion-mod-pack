{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "cases": [
      {
        "when": "vexp:weak_punch_swoosh",
        "model": {
          "type": "minecraft:model",
          "model": "vexp:block/fx/weak_punch_swoosh"
        }
      },
      {
        "when": "vexp:punch_swoosh",
        "model": {
          "type": "minecraft:model",
          "model": "vexp:block/fx/punch_swoosh"
        }
      },
      {
        "when": "vexp:sword_swoosh",
        "model": {
          "type": "minecraft:model",
          "model": "vexp:block/fx/sword_swoosh"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/firework_rocket"
    }
  }
}
