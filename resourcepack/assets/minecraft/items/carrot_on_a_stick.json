{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "cases": [
      {
        "when": "vexp:handgun",
        "model": {
          "type": "minecraft:model",
          "model": "vexp:item/pirotecnics/hand_gun"
        }
      },
      {
        "when": "vexp:gauntlets",
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:display_context",
          "cases": [
            {
              "when": ["gui", "ground", "fixed"],
              "model": {
                "type": "minecraft:model",
                "model": "vexp:item/dungeons/gauntlets"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "vexp:item/dungeons/gauntlets-hand"
          }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/carrot_on_a_stick"
    }
  }
}
