{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "cases": [
      {
        "when": "vexp:handgun",
        "model": {
          "type": "minecraft:model",
          "model": "vexp:item/pirotecnics/hand_gun"
        }
      },
      {
        "when": "vexp:gauntlets",
        "model": {
          "type": "minecraft:model",
          "model": "vexp:item/dungeons/fighting-gloves"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/carrot_on_a_stick"
    }
  }
}
