{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "cases": [
      {
        "when": "vexp:glowing_chestplate",
        "model": {
          "type": "minecraft:model",
          "model": "vexp:item/armor/glowing_chestplate"
        }
      },
      {
        "when": "vexp:emerald_chestplate",
        "model": {
          "type": "minecraft:model",
          "model": "vexp:item/armor/emerald_chestplate"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/diamond_chestplate"
    }
  }
}
