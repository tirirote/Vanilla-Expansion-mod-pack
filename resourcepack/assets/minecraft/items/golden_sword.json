{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "cases": [
      {
        "when": "vexp:golden_dagger",
        "model": {
          "type": "minecraft:model",
          "model": "vexp:item/dungeons/golden_dagger"
        }
      },
      {
        "when": "vexp:golden_spear",
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:display_context",
          "cases": [
            {
              "when": ["gui", "ground", "fixed"],
              "model": {
                "type": "minecraft:model",
                "model": "item/golden_spear"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "item/golden_spear_in_hand"
          }
        }
      },
      {
        "when": "vexp:golden_scythe",
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:display_context",
          "cases": [
            {
              "when": ["gui", "ground", "fixed"],
              "model": {
                "type": "minecraft:model",
                "model": "vexp:item/dungeons/golden_scythe"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "vexp:item/dungeons/golden_scythe_hand"
          }
        }
      },
      {
        "when": "vexp:golden_rapier",
        "model": {
          "type": "minecraft:model",
          "model": "vexp:item/dungeons/golden_rapier"
        }
      },
      {
        "when": "vexp:golden_gauntlet",
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:display_context",
          "cases": [
            {
              "when": ["gui", "ground", "fixed"],
              "model": {
                "type": "minecraft:model",
                "model": "vexp:item/dungeons/golden_gauntlet"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "vexp:item/dungeons/golden_gauntlet_hand"
          }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/golden_sword"
    }
  }
}
