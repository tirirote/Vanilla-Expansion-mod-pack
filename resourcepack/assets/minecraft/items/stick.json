            {
              "when": ["gui", "ground", "fixed"],
              "model": {
                "type": "minecraft:model",
                "model": "vexp:item/dungeons/wooden-gauntlet"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "vexp:item/dungeons/wooden-gauntlet-hand"
