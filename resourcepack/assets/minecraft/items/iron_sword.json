{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "cases": [
      {
        "when": "vexp:handgun",
        "model": {
          "type": "minecraft:model",
          "model": "vexp:item/pirotecnics/hand_gun"
        }
      },
      {
        "when": "vexp:iron_dagger",
        "model": {
          "type": "minecraft:model",
          "model": "vexp:item/dungeons/iron_dagger"
        }
      },
      {
        "when": "vexp:bone_dagger",
        "model": {
          "type": "minecraft:model",
          "model": "vexp:item/dungeons/bone_dagger"
        }
      },
      {
        "when": "vexp:bone-sword",
        "model": {
          "type": "minecraft:model",
          "model": "vexp:item/dungeons/bone_sword"
        }
      },
      {
        "when": "vexp:bone-rapier",
        "model": {
          "type": "minecraft:model",
          "model": "vexp:item/dungeons/bone-rapier"
        }
      },
      {
        "when": "vexp:bone-gauntlet",
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:display_context",
          "cases": [
            {
              "when": ["gui", "ground", "fixed"],
              "model": {
                "type": "minecraft:model",
                "model": "vexp:item/dungeons/bone-gauntlet"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "vexp:item/dungeons/bone-gauntlet-hand"
          }
        }
      },
      {
        "when": "vexp:bone-scythe",
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:display_context",
          "cases": [
            {
              "when": ["gui", "ground", "fixed"],
              "model": {
                "type": "minecraft:model",
                "model": "vexp:item/dungeons/bone-scythe"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "vexp:item/dungeons/bone-scythe-hand"
          }
        }
      },
      {
        "when": "vexp:iron-scythe",
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:display_context",
          "cases": [
            {
              "when": ["gui", "ground", "fixed"],
              "model": {
                "type": "minecraft:model",
                "model": "vexp:item/dungeons/iron-scythe"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "vexp:item/dungeons/iron-scythe-hand"
          }
        }
      },
      {
        "when": "vexp:iron-rapier",
        "model": {
          "type": "minecraft:model",
          "model": "vexp:item/dungeons/iron-rapier"
        }
      },
      {
        "when": "vexp:iron-gauntlet",
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:display_context",
          "cases": [
            {
              "when": ["gui", "ground", "fixed"],
              "model": {
                "type": "minecraft:model",
                "model": "vexp:item/dungeons/iron-gauntlet"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "vexp:item/dungeons/iron-gauntlet-hand"
          }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/iron_sword"
    }
  }
}
