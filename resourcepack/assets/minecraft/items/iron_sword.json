{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "cases": [
      {
        "when": "vexp:handgun",
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:display_context",
          "cases": [
            {
              "when": ["gui", "ground", "fixed"],
              "model": {
                "type": "minecraft:model",
                "model": "vexp:item/pirotecnics/handgun"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "vexp:item/pirotecnics/hand_gun_hand"
          }
        }
      },
      {
        "when": "vexp:iron_dagger",
        "model": {
          "type": "minecraft:model",
          "model": "vexp:item/dungeons/iron_dagger"
        }
      },
      {
        "when": "vexp:bone_dagger",
        "model": {
          "type": "minecraft:model",
          "model": "vexp:item/dungeons/bone_dagger"
        }
      },
      {
        "when": "vexp:bone_sword",
        "model": {
          "type": "minecraft:model",
          "model": "vexp:item/dungeons/bone_sword"
        }
      },
      {
        "when": "vexp:bone_rapier",
        "model": {
          "type": "minecraft:model",
          "model": "vexp:item/dungeons/bone_rapier"
        }
      },
      {
        "when": "vexp:bone_gauntlet",
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:display_context",
          "cases": [
            {
              "when": ["gui", "ground", "fixed"],
              "model": {
                "type": "minecraft:model",
                "model": "vexp:item/dungeons/bone_gauntlet"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "vexp:item/dungeons/bone_gauntlet_hand"
          }
        }
      },
      {
        "when": "vexp:bone_scythe",
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:display_context",
          "cases": [
            {
              "when": ["gui", "ground", "fixed"],
              "model": {
                "type": "minecraft:model",
                "model": "vexp:item/dungeons/bone_scythe"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "vexp:item/dungeons/bone_scythe_hand"
          }
        }
      },
      {
        "when": "vexp:iron_scythe",
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:display_context",
          "cases": [
            {
              "when": ["gui", "ground", "fixed"],
              "model": {
                "type": "minecraft:model",
                "model": "vexp:item/dungeons/iron_scythe"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "vexp:item/dungeons/iron_scythe_hand"
          }
        }
      },
      {
        "when": "vexp:iron_rapier",
        "model": {
          "type": "minecraft:model",
          "model": "vexp:item/dungeons/iron_rapier"
        }
      },
      {
        "when": "vexp:iron_gauntlet",
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:display_context",
          "cases": [
            {
              "when": ["gui", "ground", "fixed"],
              "model": {
                "type": "minecraft:model",
                "model": "vexp:item/dungeons/iron_gauntlet"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "vexp:item/dungeons/iron_gauntlet_hand"
          }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/iron_sword"
    }
  }
}
