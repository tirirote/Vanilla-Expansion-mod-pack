{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "cases": [
      {
        "when": "vexp:diamond_dagger",
        "model": {
          "type": "minecraft:model",
          "model": "vexp:item/dungeons/diamond_dagger"
        }
      },
      {
        "when": "vexp:diamond_spear",
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:display_context",
          "cases": [
            {
              "when": ["gui", "ground", "fixed"],
              "model": {
                "type": "minecraft:model",
                "model": "item/diamond_spear"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "item/diamond_spear_in_hand"
          }
        }
      },
      {
        "when": "vexp:diamond_scythe",
