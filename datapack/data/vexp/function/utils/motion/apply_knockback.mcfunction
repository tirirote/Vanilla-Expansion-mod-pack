$execute as @s[tag=!vexp.custom_block.dummy_mob,type=!item_display,type=!item,type=!marker,type=!interaction] at @s positioned ~ ~1.5 ~ if block ^ ^ ^$(strength) #replaceable if block ^ ^1 ^$(strength) #replaceable if block ^ ^-1 ^$(strength) #replaceable unless entity @p[tag=vexp.attacker,distance=..16,limit=1] facing entity @p[limit=1] feet positioned ~ ~-1.25 ~ run tp @s ^ ^$(y) ^$(strength)
