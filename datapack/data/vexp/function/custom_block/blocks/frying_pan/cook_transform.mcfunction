# Se ejecuta AS la interaction de la sarten
# Convierte el item almacenado a su version cocinada cuando corresponde

# Bayas y semillas
execute if data entity @s data.vexp.pan_item{id:"minecraft:wheat_seeds"} run scoreboard players set #did_cook vexp.math 1
execute if data entity @s data.vexp.pan_item{id:"minecraft:wheat_seeds"} run data modify entity @s data.vexp.pan_item set value {id:"minecraft:poisonous_potato",count:1,components:{"minecraft:custom_data":{vexp:{type:"food",id:"roasted_wheat_seeds"}},"minecraft:custom_model_data":{strings:["vexp:roasted_wheat_seeds"]},"minecraft:item_name":{text:"Semillas de Trigo Tostadas",italic:false},food:{nutrition:2,saturation:0.2f}}}
