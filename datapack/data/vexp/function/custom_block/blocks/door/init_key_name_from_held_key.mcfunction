# init_key_name_from_held_key.mcfunction
# Usa la llave en mano para inicializar key_name cuando la puerta bloqueada aun no tiene clave.
execute if data entity @s data.vexp{has_lock:1,key_name:""} if items entity @a[tag=vexp.door_user,limit=1] weapon.mainhand minecraft:poisonous_potato[minecraft:custom_data={vexp:{type:"key"}}] if data entity @a[tag=vexp.door_user,limit=1] SelectedItem.components."minecraft:custom_name" run data modify entity @s data.vexp.key_name set from entity @a[tag=vexp.door_user,limit=1] SelectedItem.components."minecraft:custom_name"
execute if data entity @s data.vexp{has_lock:1,key_name:""} if items entity @a[tag=vexp.door_user,limit=1] weapon.mainhand minecraft:poisonous_potato[minecraft:custom_data={vexp:{type:"key"}}] unless data entity @a[tag=vexp.door_user,limit=1] SelectedItem.components."minecraft:custom_name" run data modify entity @s data.vexp.key_name set from entity @a[tag=vexp.door_user,limit=1] SelectedItem.components."minecraft:item_name".text
